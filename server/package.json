{
  "name": "intervai-server",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "IntervAI — multi-tenant API for the AI-Powered Interview Analysis Platform",
  "main": "src/index.js",
  "scripts": {
    "start": "node src/index.js",
    "dev": "node --watch src/index.js",
    "worker": "node src/worker.js",
    "worker:dev": "node --watch src/worker.js",
    "prisma:generate": "prisma generate",
    "prisma:push": "prisma db push",
    "prisma:migrate": "prisma migrate dev",
    "db:seed": "node prisma/seed.js",
    "postinstall": "prisma generate",
    "test": "node --test test/*.test.js"
  },
  "engines": {
    "node": ">=18"
  },
  "prisma": {
    "seed": "node prisma/seed.js"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.645.0",
    "@prisma/client": "^5.19.1",
    "bcryptjs": "^2.4.3",
    "bullmq": "^5.12.12",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "ioredis": "^5.4.1",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.0.0",
    "stripe": "^16.8.0"
  },
  "devDependencies": {
    "prisma": "^5.19.1"
  }
}

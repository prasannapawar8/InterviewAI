# IntervAI backend — copy to `.env`

NODE_ENV=development
PORT=4000
CLIENT_ORIGIN=http://localhost:5173

# REQUIRED — Postgres
DATABASE_URL=postgresql://intervai:intervai@127.0.0.1:5434/intervai?schema=public

# Redis (optional locally — in-process queue is used if unset)
# REDIS_URL=redis://localhost:6379

# MUST change in production
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=15m
REFRESH_EXPIRES_DAYS=7
COOKIE_SECURE=false

DATA_DIR=./data
DEMO_EMAIL=aarav.mehta@example.com
DEMO_PASSWORD=password123

# mock | live  (live needs DEEPGRAM_API_KEY and/or OPENAI_API_KEY)
AI_PROVIDER=mock
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
DEEPGRAM_API_KEY=

# Object storage (optional — local disk used if S3_BUCKET is empty)
S3_BUCKET=
S3_REGION=us-east-1
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=false

MEDIA_RETENTION_DAYS=30
DEFAULT_MINUTES_QUOTA=120
DEFAULT_MAX_CONCURRENT=2
MAX_DURATION_SECONDS=3600

# Billing / email (optional)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID=
RESEND_API_KEY=
EMAIL_FROM=IntervAI <noreply@intervai.local>
